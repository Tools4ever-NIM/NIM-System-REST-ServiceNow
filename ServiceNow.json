    "rest": {
        "config": {
            "baseUrl": "https://{tenant_id}/api/now",
            "get": {
                "pagination": {
                    "mode": "skip_take",
                    "page_size": "{page_size}",
                    "params": {
                        "sysparm_limit": "{take_count}",
                        "sysparm_offset": "{skip_count}"
                    }
                }
            },
            "authentication": "basic_auth",
            "call_handling": "generic",
            "test_connection": {
                "url": "/table/sys_user"
            },
            "socket_timeout": 3600000,
            "accept": "application/json",
            "retry": [
                {
                    "type": "statusCode",
                    "statusCode": 429,
                    "retry": {
                        "type": "simple",
                        "maxCount": 12,
                        "waitTime": 60
                    }
                },
                {
                    "type": "statusCode",
                    "statusCode": 500,
                    "retry": {
                        "type": "simple",
                        "maxCount": 12,
                        "waitTime": 60
                    }
                },
                {
                    "type": "connectionError"
                }
            ]
        }
    },
    "connection": {
        "items": [
            {
                "name": "tenant_id",
                "type": "textbox",
                "label": "Tenent URL:",
                "value": "<customerid>.service-now.com",
                "required": true,
                "order": 1
            },
            {
                "name": "user_name",
                "type": "textbox",
                "label": "Username",
                "required": true,
                "order": 2
            },
            {
                "name": "password",
                "type": "textbox",
                "label": "Password",
                "required": true,
                "password": true,
                "order": 3
            },
            {
                "name": "page_size",
                "type": "textbox",
                "label": "Page Size:",
                "value": "50",
                "required": true,
                "order": 100
            }
        ]
    }
